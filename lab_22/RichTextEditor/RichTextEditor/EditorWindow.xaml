<Window x:Class="RichTextEditor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RichTextEditor"
        Title="RTF Editor"
        Height="680" Width="900"
        MinHeight="400" MinWidth="600"
        Background="{StaticResource WindowBgBrush}"
        Closing="Window_Closing">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"    Executed="New_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open"   Executed="Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save"   Executed="Save_Executed"/>
        <CommandBinding Command="local:EditorCommands.SaveAs"     Executed="SaveAs_Executed"/>
        <CommandBinding Command="local:EditorCommands.NewWindow"  Executed="NewWindow_Executed"/>
        <CommandBinding Command="local:EditorCommands.InsertImage" Executed="InsertImage_Executed"/>
        <CommandBinding Command="local:EditorCommands.FontColor"   Executed="FontColor_Executed"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- ===== MENU BAR ===== -->
        <Menu DockPanel.Dock="Top"
              Background="{StaticResource ToolbarBgBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              FontFamily="Segoe UI" FontSize="13">

            <!-- File -->
            <MenuItem Header="{Binding Loc.File}" Padding="8,4">
                <MenuItem Header="{Binding Loc.New}"       Command="ApplicationCommands.New"
                          InputGestureText="Ctrl+N"/>
                <MenuItem Header="{Binding Loc.NewWindow}" Command="{x:Static local:EditorCommands.NewWindow}"
                          InputGestureText="Ctrl+Shift+N"/>
                <Separator/>
                <MenuItem Header="{Binding Loc.Open}"      Command="ApplicationCommands.Open"
                          InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="{Binding Loc.Save}"      Command="ApplicationCommands.Save"
                          InputGestureText="Ctrl+S"/>
                <MenuItem Header="{Binding Loc.SaveAs}"    Command="{x:Static local:EditorCommands.SaveAs}"/>
                <Separator/>
                <MenuItem Header="{Binding Loc.Close}"     Click="Close_Click"/>
                <MenuItem Header="{Binding Loc.Exit}"      Click="Exit_Click"/>
            </MenuItem>

            <!-- Edit -->
            <MenuItem Header="{Binding Loc.Edit}" Padding="8,4">
                <MenuItem Header="{Binding Loc.Undo}"      Command="ApplicationCommands.Undo"/>
                <MenuItem Header="{Binding Loc.Redo}"      Command="ApplicationCommands.Redo"/>
                <Separator/>
                <MenuItem Header="{Binding Loc.Cut}"       Command="ApplicationCommands.Cut"/>
                <MenuItem Header="{Binding Loc.Copy}"      Command="ApplicationCommands.Copy"/>
                <MenuItem Header="{Binding Loc.Paste}"     Command="ApplicationCommands.Paste"/>
                <Separator/>
                <MenuItem Header="{Binding Loc.SelectAll}" Command="ApplicationCommands.SelectAll"/>
            </MenuItem>

            <!-- Insert -->
            <MenuItem Header="{Binding Loc.Insert}" Padding="8,4">
                <MenuItem Header="{Binding Loc.InsertImage}" Command="{x:Static local:EditorCommands.InsertImage}"/>
            </MenuItem>

            <!-- Format -->
            <MenuItem Header="{Binding Loc.Format}" Padding="8,4">
                <MenuItem Header="{Binding Loc.AlignLeft}"    Command="EditingCommands.AlignLeft"/>
                <MenuItem Header="{Binding Loc.AlignCenter}"  Command="EditingCommands.AlignCenter"/>
                <MenuItem Header="{Binding Loc.AlignRight}"   Command="EditingCommands.AlignRight"/>
                <MenuItem Header="{Binding Loc.AlignJustify}" Command="EditingCommands.AlignJustify"/>
                <Separator/>
                <MenuItem Header="{Binding Loc.FontColor}"    Command="{x:Static local:EditorCommands.FontColor}"/>
            </MenuItem>

            <!-- Language -->
            <MenuItem Header="{Binding Loc.LanguageMenu}" Padding="8,4">
                <MenuItem Header="{Binding Loc.LangUkrainian}" Click="LangUkr_Click"
                          IsCheckable="True" IsChecked="{Binding IsUkrainian}"/>
                <MenuItem Header="{Binding Loc.LangEnglish}"   Click="LangEng_Click"
                          IsCheckable="True" IsChecked="{Binding IsEnglish}"/>
            </MenuItem>

            <!-- View -->
            <MenuItem Header="{Binding Loc.View}" Padding="8,4">
                <MenuItem Header="{Binding Loc.Windows}" Click="ShowWindowList_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== TOOLBAR ===== -->
        <ToolBarTray DockPanel.Dock="Top"
                     Background="{StaticResource ToolbarBgBrush}">
            <ToolBar Background="Transparent" Band="0" BandIndex="0"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">

                <!-- Open / Save -->
                <Button Command="ApplicationCommands.Open"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{Binding Loc.TtOpen}">
                    <TextBlock Text="📂" FontSize="15"/>
                </Button>
                <Button Command="ApplicationCommands.Save"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{Binding Loc.TtSave}">
                    <TextBlock Text="💾" FontSize="15"/>
                </Button>

                <Separator/>

                <!-- Bold / Italic / Underline -->
                <ToggleButton Command="EditingCommands.ToggleBold"
                              Name="btnBold"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              ToolTip="{Binding Loc.TtBold}">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="14" Width="16" TextAlignment="Center"/>
                </ToggleButton>
                <ToggleButton Command="EditingCommands.ToggleItalic"
                              Name="btnItalic"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              ToolTip="{Binding Loc.TtItalic}">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="14" Width="16" TextAlignment="Center"/>
                </ToggleButton>
                <ToggleButton Command="EditingCommands.ToggleUnderline"
                              Name="btnUnderline"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              ToolTip="{Binding Loc.TtUnderline}">
                    <TextBlock Text="U" FontSize="14" Width="16" TextAlignment="Center">
                        <TextBlock.TextDecorations>
                            <TextDecoration Location="Underline"/>
                        </TextBlock.TextDecorations>
                    </TextBlock>
                </ToggleButton>

                <Separator/>

                <!-- Alignment -->
                <ToggleButton Name="btnAlignLeft"
                              Command="EditingCommands.AlignLeft"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              ToolTip="{Binding Loc.TtAlignLeft}">
                    <TextBlock Text="≡" FontSize="15" Width="16" TextAlignment="Center"/>
                </ToggleButton>
                <ToggleButton Name="btnAlignCenter"
                              Command="EditingCommands.AlignCenter"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              ToolTip="{Binding Loc.TtAlignCenter}">
                    <TextBlock Text="≡" FontSize="15" Width="16" TextAlignment="Center"/>
                </ToggleButton>
                <ToggleButton Name="btnAlignRight"
                              Command="EditingCommands.AlignRight"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              ToolTip="{Binding Loc.TtAlignRight}">
                    <TextBlock Text="≡" FontSize="15" Width="16" TextAlignment="Center"/>
                </ToggleButton>
                <ToggleButton Name="btnAlignJustify"
                              Command="EditingCommands.AlignJustify"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              ToolTip="{Binding Loc.TtAlignJustify}">
                    <TextBlock Text="≡" FontSize="15" Width="16" TextAlignment="Center"/>
                </ToggleButton>

                <Separator/>

                <!-- Font Color -->
                <Button Command="{x:Static local:EditorCommands.FontColor}"
                        Name="btnFontColor"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{Binding Loc.TtFontColor}">
                    <StackPanel Orientation="Vertical" Width="20">
                        <TextBlock Text="A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Rectangle Height="3" Width="16" HorizontalAlignment="Center"
                                   Name="rectFontColor" Fill="Red"/>
                    </StackPanel>
                </Button>

                <!-- Insert Image -->
                <Button Command="{x:Static local:EditorCommands.InsertImage}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{Binding Loc.TtInsertImage}">
                    <TextBlock Text="🖼" FontSize="15"/>
                </Button>

                <Separator/>

                <!-- Font family -->
                <ComboBox Name="cmbFontFamily"
                          Style="{StaticResource ToolbarComboStyle}"
                          Width="160"
                          SelectionChanged="cmbFontFamily_SelectionChanged"/>

                <!-- Font size -->
                <ComboBox Name="cmbFontSize"
                          Style="{StaticResource ToolbarComboStyle}"
                          Width="56"
                          IsEditable="True"
                          TextBoxBase.TextChanged="cmbFontSize_TextChanged"/>
            </ToolBar>
        </ToolBarTray>

        <!-- ===== STATUS BAR ===== -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{StaticResource ToolbarBgBrush}"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,1,0,0"
                   FontFamily="Segoe UI" FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}">
            <StatusBarItem>
                <TextBlock Name="tbStatusMsg" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Name="tbStatusPos"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== EDITOR AREA ===== -->
        <Border Background="White" Margin="0" Padding="0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
            <RichTextBox Name="rtbEditor"
                         Style="{StaticResource EditorRtbStyle}"
                         SelectionChanged="rtbEditor_SelectionChanged"
                         KeyUp="rtbEditor_KeyUp"/>
        </Border>
    </DockPanel>
</Window>
