<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Manager" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Window.Resources>
        <Style x:Key="ColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="ListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F2D3D"/>
                    <Setter Property="BorderBrush" Value="#1F6FEB"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161B22"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#161B22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D1B1B"/>
                    <Setter Property="BorderBrush" Value="#F85149"/>
                    <Setter Property="Foreground" Value="#F85149"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1A2A3A"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F3550"/>
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#58A6FF"/>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0D1117"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="#58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C9D1D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#21262D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Process Manager" FontFamily="Segoe UI Semibold" FontSize="18"
                               Foreground="#F0F6FC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtProcessCount" Text="" FontFamily="Consolas" FontSize="11"
                               Foreground="#58A6FF" VerticalAlignment="Center" Margin="12,0,0,0"
                               Background="#1A2A3A" Padding="6,2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="Оновити" Style="{StaticResource PrimaryButton}"
                            Click="BtnRefresh_Click" Width="100" Margin="0,0,8,0"/>
                    <Button x:Name="btnExport" Content="Експорт" Style="{StaticResource ActionButton}"
                            Click="BtnExport_Click" Width="100" Margin="0,0,8,0"/>
                    <Button x:Name="btnKill" Content="Зупинити" Style="{StaticResource DangerButton}"
                            Click="BtnKill_Click" Width="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar / Search -->
        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Пошук:" Foreground="#8B949E" FontFamily="Segoe UI"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtSearch" Style="{StaticResource SearchBox}"
                             Width="300" Height="30"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="фільтр за назвою або PID" Foreground="#484F58" FontFamily="Segoe UI"
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="txtLastUpdate" Grid.Column="1" Text="" Foreground="#484F58"
                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Process List -->
        <Grid Grid.Row="2" Margin="16,12,16,0">
            <ListView x:Name="lvProcesses"
                      Background="Transparent"
                      BorderBrush="#30363D"
                      BorderThickness="1"
                      Foreground="#C9D1D9"
                      FontFamily="Consolas"
                      FontSize="12"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}"
                      SelectionChanged="LvProcesses_SelectionChanged">

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Інформація про процес" Click="MenuInfo_Click"/>
                        <MenuItem Header="Потоки процесу" Click="MenuThreads_Click"/>
                        <MenuItem Header="Модулі процесу" Click="MenuModules_Click"/>
                        <Separator Background="#30363D"/>
                        <MenuItem Header="Зупинити процес" Click="BtnKill_Click" Foreground="#F85149"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                        <GridViewColumn Header="ID" Width="70" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Назва процесу" Width="220" DisplayMemberBinding="{Binding ProcessName}"/>
                        <GridViewColumn Header="Пам'ять (KB)" Width="120" DisplayMemberBinding="{Binding MemoryKB}"/>
                        <GridViewColumn Header="Вірт. пам'ять (MB)" Width="150" DisplayMemberBinding="{Binding VirtualMemoryMB}"/>
                        <GridViewColumn Header="Потоки" Width="70" DisplayMemberBinding="{Binding ThreadCount}"/>
                        <GridViewColumn Header="Час запуску" Width="160" DisplayMemberBinding="{Binding StartTime}"/>
                        <GridViewColumn Header="Модуль" Width="200" DisplayMemberBinding="{Binding MainModule}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Info Panel -->
        <Grid Grid.Row="3" Margin="16,8,16,8">
            <TabControl x:Name="tabInfo" Background="#0D1117" BorderBrush="#30363D">
                <TabItem Header="Інформація" Style="{StaticResource DarkTabItem}">
                    <Grid Background="#0D1117">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="16,12">
                            <TextBlock Text="ДЕТАЛІ ПРОЦЕСУ" FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#484F58" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" Foreground="#8B949E" FontFamily="Segoe UI" FontSize="12" Padding="0,3"/>
                                <TextBlock x:Name="lblId" Grid.Row="0" Grid.Column="1" Text="—" Foreground="#58A6FF" FontFamily="Consolas" FontSize="12" Padding="0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Назва:" Foreground="#8B949E" FontFamily="Segoe UI" FontSize="12" Padding="0,3"/>
                                <TextBlock x:Name="lblName" Grid.Row="1" Grid.Column="1" Text="—" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="12" Padding="0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Машина:" Foreground="#8B949E" FontFamily="Segoe UI" FontSize="12" Padding="0,3"/>
                                <TextBlock x:Name="lblMachine" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="12" Padding="0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Час запуску:" Foreground="#8B949E" FontFamily="Segoe UI" FontSize="12" Padding="0,3"/>
                                <TextBlock x:Name="lblStartTime" Grid.Row="3" Grid.Column="1" Text="—" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="12" Padding="0,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Пам'ять:" Foreground="#8B949E" FontFamily="Segoe UI" FontSize="12" Padding="0,3"/>
                                <TextBlock x:Name="lblMemory" Grid.Row="4" Grid.Column="1" Text="—" Foreground="#3FB950" FontFamily="Consolas" FontSize="12" Padding="0,3"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Вірт. пам'ять:" Foreground="#8B949E" FontFamily="Segoe UI" FontSize="12" Padding="0,3"/>
                                <TextBlock x:Name="lblVirtMemory" Grid.Row="5" Grid.Column="1" Text="—" Foreground="#3FB950" FontFamily="Consolas" FontSize="12" Padding="0,3"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,12">
                            <TextBlock Text="ВИКОНУВАНИЙ ФАЙЛ" FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#484F58" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="lblMainModule" Text="—" Foreground="#C9D1D9"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Потоки" Style="{StaticResource DarkTabItem}">
                    <ListView x:Name="lvThreads" Background="#0D1117" BorderThickness="0"
                              Foreground="#C9D1D9" FontFamily="Consolas" FontSize="11">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                                <GridViewColumn Header="Thread ID" Width="100" DisplayMemberBinding="{Binding Id}"/>
                                <GridViewColumn Header="Пріоритет" Width="130" DisplayMemberBinding="{Binding PriorityLevel}"/>
                                <GridViewColumn Header="Поточний пріоритет" Width="160" DisplayMemberBinding="{Binding CurrentPriority}"/>
                                <GridViewColumn Header="Час запуску" Width="180" DisplayMemberBinding="{Binding StartTime}"/>
                                <GridViewColumn Header="Адреса запуску" Width="160" DisplayMemberBinding="{Binding StartAddress}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="Модулі" Style="{StaticResource DarkTabItem}">
                    <ListView x:Name="lvModules" Background="#0D1117" BorderThickness="0"
                              Foreground="#C9D1D9" FontFamily="Consolas" FontSize="11">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                                <GridViewColumn Header="Назва" Width="180" DisplayMemberBinding="{Binding ModuleName}"/>
                                <GridViewColumn Header="Шлях до файлу" Width="360" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="Розмір (KB)" Width="110" DisplayMemberBinding="{Binding MemorySizeKB}"/>
                                <GridViewColumn Header="Базова адреса" Width="140" DisplayMemberBinding="{Binding BaseAddress}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Text="Готово" Foreground="#8B949E"
                           FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Process Manager  |  C# WPF  |  .NET Framework 4.8"
                           Foreground="#484F58" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
